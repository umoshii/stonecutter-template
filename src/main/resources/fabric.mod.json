{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_desc}",

	"authors": [
		"Me!"
	],

	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},

	"license": "Apache-2.0",
	"icon": "assets/template/icon.png",
	"environment": "*",

	"entrypoints": {
		"main": [
			{
				"value": "io.github.umoshii.template.Template",
				"adapter": "kotlin"
			}
		]
	},

	"mixins": [
		"template.mixins.json"
	],

	"depends": {
		"minecraft": "${mod_mc_compat}",
		"fabricloader": ">=0.19.3",
		"java": ">=25",

		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}